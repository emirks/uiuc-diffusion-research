# campaign scratch dirs (dossiers, vendored code, artifacts) — never git
/misc/
# trainer fork checkouts under src/ (LTX-2-official + its linked worktrees, own .git)
/src/LTX-2-official/
/src/LTX-2-cond-bleed-fix/
/src/LTX-2-ctt-v2-train/
/src/LTX-2-bneck/

