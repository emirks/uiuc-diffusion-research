*.ckpt
*.pth
*.onnx
*.gguf
# slurm job logs written next to the experiment
experiments/**/*_[0-9]*.out
experiments/**/*_[0-9]*.err
scripts/**/logs/*_[0-9]*.out
scripts/**/logs/*_[0-9]*.err

# ladder2 bulk artefacts (regenerable): conditioning window cuts + assembled training roots
eval_ladder/conds/
eval_ladder/dataset/
experiments/exp_079_standalone_operator_encoder/dataset/

# finalized datasets are data, never git (public repo)
datasets/

